#extern vec2 u_resolution
#extern float u_time

type option['a] = Some of 'a | None

// constants
let speed     = 0.2
let levels    = 4
let max_steps = 128
let max_dist  = 20.0
let epsilon   = 0.0005

let rot_y (p : vec3) (a : float) =
  let s = #sin a in
  let c = #cos a in
  [p.0 * c - p.2 * s, p.1, p.0 * s + p.2 * c]

let sdf_box (p : vec3) (b : vec3) =
  let q = #abs p - b in
  #length (#max q [0, 0, 0]) + #min (#max q.0 (#max q.1 q.2)) 0

// menger sponge
let rec menger (p : vec3) (dist : float) (scale : float) (n : int) : float =
  if n = 0 then dist
  else
    let cell  = p * scale - 2 * #floor (p * scale / 2) - 1 in
    let next  = scale * 3 in
    let r     = #abs (1 - 3 * #abs cell) in
    let cross = (#min (#min (#max r.0 r.1) (#max r.1 r.2)) (#max r.2 r.0) - 1) / next in
    menger p (#max dist cross) next (n - 1)

let scene (p : vec3) =
  let q   = rot_y p (u_time * speed) in
  let box = sdf_box q [1, 1, 1] in
  menger q box 1.0 levels

let march (ro : vec3) (rd : vec3) =
  let rec step (t : float) (i : int) =
    if i >= max_steps then None
    else
      let d = scene (ro + rd * t) in
      let dt = #max (d * 0.85) (epsilon * 0.5) in
      if d < epsilon then Some t
      else if t > max_dist then None
      else step (t + dt) (i + 1)
  in
  step 0.0 0

let normal (p : vec3) =
  let e = epsilon in
  #normalize [scene (p + [e, 0, 0]) - scene (p - [e, 0, 0]),
              scene (p + [0, e, 0]) - scene (p - [0, e, 0]),
              scene (p + [0, 0, e]) - scene (p - [0, 0, e])]

let pal (t : float) = #cos (([0.2, 0.4, 0.6] + t) * 6.283) * 0.5 + 0.5

let main (coord : vec2) =
  let uv = (coord * 2 - u_resolution) / #min u_resolution.0 u_resolution.1 in
  let ro = [0, 0, -3] in
  let rd = #normalize [uv.0, uv.1, 1.6] in
  match march ro rd with
  | None   -> [0.02, 0.02, 0.04]
  | Some t ->
    let n     = normal (ro + rd * t) in
    let light = #normalize [0.6, 0.8, -0.4] in
    let diff  = #max (#dot n light) 0 in
    let fog   = 1 - 0.05 * t in
    pal (t * 0.2) * (0.15 + 0.85 * diff) * fog
