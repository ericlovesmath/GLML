#extern vec2 u_resolution

// Palette
let grass_lt  = [0.62, 0.78, 0.40]
let grass_dk  = [0.34, 0.52, 0.22]

let brown     = [0.55, 0.34, 0.16]
let brown_lt  = [0.68, 0.46, 0.24]
let brown_dk  = [0.38, 0.22, 0.08]
let drk_brown = [0.22, 0.11, 0.03]
let cream     = [0.95, 0.89, 0.74]
let cream_dk  = [0.78, 0.68, 0.50]
let pink      = [0.92, 0.62, 0.60]
let black     = [0.06, 0.04, 0.03]
let wht       = [1.00, 0.97, 0.93]
let tooth_yel = [0.94, 0.88, 0.62]

let wood_lt   = [0.80, 0.60, 0.38]
let wood      = [0.62, 0.42, 0.22]
let wood_dk   = [0.40, 0.25, 0.12]
let bark      = [0.30, 0.18, 0.08]

let get_uv coord =
  let top = 2 * coord - u_resolution in
  let bot = #min u_resolution.0 u_resolution.1 in
  top / bot

let at (offset : vec2) (p : vec2) = p - offset

let ellipse (ab : vec2) (p : vec2) = (#length (p / ab) - 1) * #min ab.0 ab.1

let circle (r : float) (p : vec2) = #length p - r

let box (b : vec2) (p : vec2) =
  let d = #abs p - b in
  #length (#max d [0, 0]) + #min (#max d.0 d.1) 0

let rot (a : float) (p : vec2) =
  let c = #cos a in
  let s = #sin a in
  [c * p.0 - s * p.1, s * p.0 + c * p.1]

let smin (a : float) (b : float) (k : float) =
  let h = #max (k - #abs (a - b)) 0 / k in
  #min a b - h * h * k * 0.25

let smax (a : float) (b : float) (k : float) =
  let h = #max (k - #abs (a - b)) 0 / k in
  #max a b + h * h * k * 0.25

// Anti-aliased edge with adjustable width
let paint_w (w : float) (d : float) (shape_col : vec3) (bg : vec3) =
  #mix shape_col bg (#smoothstep (-w) w d)

let paint (d : float) (shape_col : vec3) (bg : vec3) = paint_w 0.0025 d shape_col bg

// Paint with inner edge shadow for depth
let paint_shaded (d : float) (shape_col : vec3) (shadow_col : vec3) (shadow_depth : float) (bg : vec3) =
  let base  = #mix shape_col bg (#smoothstep (-0.0025) 0.0025 d) in
  let shade = #smoothstep (-shadow_depth) 0 d in
  #mix base (#mix shape_col shadow_col (shade * 0.55)) (#smoothstep 0.0025 (-0.0025) d)

// Tint only inside d < 0, with strength s
let tint (d : float) (col : vec3) (s : float) (bg : vec3) =
  #mix bg col (s * #smoothstep 0.003 (-0.003) d)

// Soft feathered tint
let soft_tint (d : float) (col : vec3) (s : float) (f : float) (bg : vec3) =
  #mix bg col (s * #smoothstep 0 (-f) d)

let main (coord : vec2) =
  let p = get_uv coord / 1.5 in

  // Top-down light
  let light      = #smoothstep (-0.45) 0.40 p.1 in
  let body_col   = #mix brown_dk brown_lt (light * 0.85 + 0.10) in
  let belly_col  = #mix cream_dk cream    (light * 0.90 + 0.05) in
  let ear_col    = #mix brown_dk brown    (light * 0.70 + 0.20) in
  let muzzle_col = #mix cream_dk cream    (light * 0.80 + 0.15) in

  // -- Background --
  let bg = #mix grass_dk grass_lt (#smoothstep (-0.8) 0.8 p.1) in

  // -- Body parts --
  // Tail
  let tp          = p |> at [0.30, -0.30] |> rot (-0.35) in
  let tail        = tp |> ellipse [0.22, 0.085] in
  let tail_rim    = #max tail (-(tail + 0.020)) in
  // Diamond crosshatch
  let g1          = #abs (#sin ((tp.0 + tp.1) * 38.0)) in
  let g2          = #abs (#sin ((tp.0 - tp.1) * 38.0)) in
  let scale_pat   = #min g1 g2 - 0.45 in
  let tail_scales = #max (tail + 0.012) (scale_pat * 0.012) in

  // Body, Head, Cheeks
  let body_top          = p |> at [0.0, -0.04] |> ellipse [0.185, 0.135] in
  let body_bot          = p |> at [0.0, -0.24] |> ellipse [0.260, 0.185] in
  let body              = smin body_top body_bot 0.12 in
  let head              = p |> at [0.0,  0.18] |> ellipse [0.200, 0.180] in
  let torso             = smin body head 0.10 in
  let cheek_l           = p |> at [-0.128, 0.092] |> circle 0.086 in
  let cheek_r           = p |> at [ 0.128, 0.092] |> circle 0.086 in
  let cheeks            = #min cheek_l cheek_r in
  let torso_with_cheeks = smin torso cheeks 0.06 in

  // Face features
  let muzzle   = p |> at [0.0,  0.080]   |> ellipse [0.115, 0.082] in
  let blush_l  = p |> at [-0.118, 0.090] |> circle 0.030 in
  let blush_r  = p |> at [ 0.118, 0.090] |> circle 0.030 in
  // Belly patch
  let belly_top = p |> at [0.0, -0.10] |> ellipse [0.125, 0.090] in
  let belly_bot = p |> at [0.0, -0.24] |> ellipse [0.160, 0.140] in
  let belly     = smin belly_top belly_bot 0.12 in
  let ear_l    = p |> at [-0.155, 0.318] |> circle 0.065 in
  let ear_r    = p |> at [ 0.155, 0.318] |> circle 0.065 in
  let ear_in_l = p |> at [-0.155, 0.310] |> ellipse [0.030, 0.036] in
  let ear_in_r = p |> at [ 0.155, 0.310] |> ellipse [0.030, 0.036] in

  // Arms
  let arm_l = p |> at [-0.13, -0.20] |> rot (-0.70) |> ellipse [0.045, 0.090] in
  let arm_r = p |> at [ 0.13, -0.20] |> rot   0.70  |> ellipse [0.045, 0.090] in
  let paw_l = p |> at [-0.055, -0.255] |> circle 0.052 in
  let paw_r = p |> at [ 0.055, -0.255] |> circle 0.052 in

  let foot_l = p |> at [-0.13, -0.42] |> ellipse [0.095, 0.048] in
  let foot_r = p |> at [ 0.13, -0.42] |> ellipse [0.095, 0.048] in

  // Teeth
  let tooth_l = p |> at [-0.022, 0.022] |> box [0.018, 0.040] in
  let tooth_r = p |> at [ 0.022, 0.022] |> box [0.018, 0.040] in
  let teeth   = #min tooth_l tooth_r in
  let groove  = p |> at [0.0, 0.022]    |> box [0.004, 0.040] in

  // Nose
  let nose    = p |> at [0.0,    0.122] |> ellipse [0.032, 0.024] in
  let nose_hi = p |> at [-0.010, 0.128] |> ellipse [0.010, 0.007] in

  // Eyes
  let eye_l = p |> at [-0.085, 0.212] |> circle 0.034 in
  let eye_r = p |> at [ 0.085, 0.212] |> circle 0.034 in
  let hi_l  = p |> at [-0.074, 0.224] |> circle 0.012 in
  let hi_r  = p |> at [ 0.096, 0.224] |> circle 0.012 in
  let hi_l2 = p |> at [-0.094, 0.204] |> circle 0.005 in
  let hi_r2 = p |> at [ 0.076, 0.204] |> circle 0.005 in

  // Eyebrows
  let brow_l = p |> at [-0.085, 0.266] |> rot   0.20  |> ellipse [0.030, 0.008] in
  let brow_r = p |> at [ 0.085, 0.266] |> rot (-0.20) |> ellipse [0.030, 0.008] in

  // Whiskers
  let wp_l = p |> at [-0.115, 0.085] |> rot   0.05 in
  let wp_r = p |> at [ 0.115, 0.085] |> rot (-0.05) in
  let whisk_l1 = box [0.040, 0.0010] (wp_l |> at [-0.040,  0.010]) in
  let whisk_l2 = box [0.040, 0.0010] (wp_l |> at [-0.040, -0.010]) in
  let whisk_r1 = box [0.040, 0.0010] (wp_r |> at [ 0.040,  0.010]) in
  let whisk_r2 = box [0.040, 0.0010] (wp_r |> at [ 0.040, -0.010]) in
  let whiskers = #min (#min whisk_l1 whisk_l2) (#min whisk_r1 whisk_r2) in

  let neck_shadow = p |> at [0.0, -0.02] |> ellipse [0.165, 0.055] in
  let head_hilite = p |> at [-0.025, 0.28] |> ellipse [0.110, 0.050] in
  let belly_shadow = p |> at [0.0, -0.30] |> ellipse [0.130, 0.060] in

  // Ground shadow under the beaver
  let shadow_d       = p |> at [0.02, -0.46] |> ellipse [0.40, 0.045] in
  let shadow_falloff = #smoothstep 0.06 (-0.02) shadow_d in
  let bg             = #mix bg [0.18, 0.28, 0.12] (shadow_falloff * 0.50) in
  let color = // -- Composition --
  bg
  // Tail (behind body)
  |> paint tail        brown_dk
  |> paint tail_rim    drk_brown
  |> paint tail_scales drk_brown
  // Feet (behind body)
  |> paint foot_l      drk_brown
  |> paint foot_r      drk_brown
  // Body (top-lit)
  |> paint_shaded torso_with_cheeks body_col brown_dk 0.08
  // Belly with vertical gradient
  |> paint_shaded belly belly_col cream_dk 0.05
  // Belly underside shadow
  |> soft_tint (#max belly_shadow belly) brown_dk 0.18 0.08
  // Head cast-shadow onto chest
  |> soft_tint (#max neck_shadow (#max torso_with_cheeks (-belly))) brown_dk 0.35 0.05
  // Blush on cheeks
  |> tint (#min blush_l blush_r) pink 0.35
  // Arms + paws resting on the body
  |> paint arm_l brown_dk
  |> paint arm_r brown_dk
  |> paint paw_l body_col
  |> paint paw_r body_col
  // Ears
  |> paint ear_l    ear_col
  |> paint ear_r    ear_col
  |> paint ear_in_l pink
  |> paint ear_in_r pink
  // Muzzle
  |> paint muzzle muzzle_col
  // Soft top highlight on head
  |> soft_tint (#max head_hilite torso_with_cheeks) wht 0.18 0.06
  // Brows
  |> paint brow_l drk_brown
  |> paint brow_r drk_brown
  // Teeth + nose + eyes (front-most face)
  |> paint teeth   tooth_yel
  |> paint groove  brown_dk
  |> paint nose    drk_brown
  |> paint nose_hi brown_lt
  |> paint eye_l   black
  |> paint eye_r   black
  |> paint_w 0.003 whiskers brown_dk
  |> paint hi_l  wht
  |> paint hi_r  wht
  |> paint hi_l2 wht
  |> paint hi_r2 wht in
  [color.0, color.1, color.2, 1.0]
