// Bezier Curves with de Casteljau construction
// Drag the control points around!

#extern vec2 u_resolution
#extern float u_time
#extern sampler bufferA

type color = vec4
type layer = color -> color

// Palette
let bg = [0.04, 0.05, 0.08, 1.0]
let cool = [0.35, 0.62, 0.85, 1.0]
let warm = [1.0, 0.72, 0.28, 1.0]

let level1 = #mix cool warm 0.34
let level2 = #mix cool warm 0.67

// Read control point [i]
let load (i : float) =
  let v = #texture bufferA ([i + 0.5, 0.5] / u_resolution) in
  [v.0, v.1]

// Full de Casteljau construction
let decasteljau (p0 : vec2) (p1 : vec2) (p2 : vec2) (p3 : vec2) (t : float) =
  let a = #mix p0 p1 t in
  let b = #mix p1 p2 t in
  let c = #mix p2 p3 t in
  let d = #mix a b t in
  let e = #mix b c t in
  let f = #mix d e t in
  (a, b, c, d, e, f)

// Distance from [p] to line segment [a] to [b]
let sd_segment (p : vec2) (a : vec2) (b : vec2) =
  let pa = p - a in
  let ba = b - a in
  let h = #clamp (#dot pa ba / #dot ba ba) 0 1 in
  #length (pa - ba * h)

// Closest approach of [ap] to the curve
let curve_dist (ap : vec2) (p0 : vec2) (p1 : vec2) (p2 : vec2) (p3 : vec2) =
  let rec go (t : float) (best : float) =
    if t >= 1.0 then best
    else
      let tn = #min (t + 0.02) 1.0 in
      let (_, _, _, _, _, q0) = decasteljau p0 p1 p2 p3 t in
      let (_, _, _, _, _, q1) = decasteljau p0 p1 p2 p3 tn in
      go tn (#min best (sd_segment ap q0 q1))
  in
  go 0.0 99.0

let main (coord : vec2) =
  let ap = coord / u_resolution in

  let p0 = load 0 in
  let p1 = load 1 in
  let p2 = load 2 in
  let p3 = load 3 in

  let t = 0.5 - 0.5 * #cos (u_time * 0.9) in
  let (a, b, c, d, e, f) = decasteljau p0 p1 p2 p3 t in

  // Stroke segment [s0] to [s1] of width [w]
  let stroke col w s0 s1 : layer =
    fun acc ->
      let d = sd_segment ap s0 s1 in
      #mix acc col (1 - #smoothstep w (w + 0.0015) d)
  in

  // Filled disc of radius [r] at [p]
  let disc col r p : layer =
    fun acc ->
      let dd = #distance ap p in
      #mix acc col (1 - #smoothstep r (r + 0.002) dd)
  in

  // Add glow to the curve
  let draw_curve : layer =
    fun acc ->
      let cd = curve_dist ap p0 p1 p2 p3 in
      let glow = warm * (0.0035 / (cd + 0.0035)) * 0.5 in
      #mix (acc + glow) warm (1 - #smoothstep 0.0035 0.006 cd)
  in

  // control polygon with gradient
  bg
  |> stroke (cool * 0.35) 0.0014 p0 p1
  |> stroke (cool * 0.35) 0.0014 p1 p2
  |> stroke (cool * 0.35) 0.0014 p2 p3
  |> stroke level1 0.0012 a b
  |> stroke level1 0.0012 b c
  |> stroke level2 0.0012 d e

  // curve, scaffold points, point gliding along it
  |> draw_curve
  |> disc level1 0.007 a
  |> disc level1 0.007 b
  |> disc level1 0.007 c
  |> disc level2 0.007 d
  |> disc level2 0.007 e
  |> disc warm 0.012 f

  // draggable handles
  |> disc warm 0.018 p0
  |> disc cool 0.018 p1
  |> disc cool 0.018 p2
  |> disc warm 0.018 p3
